<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container flex-grow-1">
  <h1 class="h4 mb-3">Модерация отзывов</h1>
  <div class="mb-3">
    <a class="btn btn-sm <%= filter1 === 'pending' ? 'btn-primary' : 'btn-outline-secondary' %>" href="/admin/reviews?filter=pending">На модерации</a>
    <a class="btn btn-sm <%= filter1 === 'published' ? 'btn-primary' : 'btn-outline-secondary' %>" href="/admin/reviews?filter=published">Опубликованные</a>
    <a class="btn btn-sm <%= filter1 === 'rejected' ? 'btn-primary' : 'btn-outline-secondary' %>" href="/admin/reviews?filter=rejected">Отклонённые</a>
    <a class="btn btn-sm <%= filter1 === 'all' ? 'btn-primary' : 'btn-outline-secondary' %>" href="/admin/reviews?filter=all">Все</a>
  </div>
  <% if (!reviewList.length) { %>
    <p class="text-muted">Нет отзывов.</p>
  <% } else { %>
    <% reviewList.forEach(function (r) { %>
      <div class="card mb-3">
        <div class="card-body">
          <p class="mb-1"><strong><%= r.rating %>/5</strong> — <%= r.course_title %> (заявка №<%= r.application_ref %>)</p>
          <p class="small text-muted"><%= r.user_name %> (<%= r.user_login %>) · <%= REVIEW_STATUS[r.moderation_status] %></p>
          <p><%= r.body %></p>
          <% if (r.moderation_status === 'pending') { %>
            <form method="post" action="/admin/reviews/<%= r.id %>/moderate" class="d-inline">
              <input type="hidden" name="action" value="publish">
              <button type="submit" class="btn btn-sm btn-success">Опубликовать</button>
            </form>
            <form method="post" action="/admin/reviews/<%= r.id %>/moderate" class="d-inline">
              <input type="hidden" name="action" value="reject">
              <button type="submit" class="btn btn-sm btn-outline-danger">Отклонить</button>
            </form>
          <% } %>
        </div>
      </div>
    <% }); %>
  <% } %>
  <a href="/admin" class="btn btn-link">Назад</a>
</main>
<%- include('../partials/footer') %>
