<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container flex-grow-1">
  <h1 class="h4 mb-3">Все заявки</h1>
  <div class="mb-3">
    <a class="btn btn-sm <%= !filterStatus ? 'btn-dark' : 'btn-outline-secondary' %>" href="/admin/applications">Все</a>
    <% ['new','in_progress','completed'].forEach(function (s) { %>
      <a class="btn btn-sm <%= filterStatus === s ? 'btn-primary' : 'btn-outline-secondary' %>"
         href="/admin/applications?status=<%= s %>"><%= APPLICATION_STATUS[s] %></a>
    <% }); %>
  </div>
  <div class="table-responsive">
    <table class="table table-sm table-bordered align-middle">
      <thead>
        <tr>
          <th>№</th>
          <th>Пользователь</th>
          <th>Курс</th>
          <th>Дата</th>
          <th>Оплата</th>
          <th>Статус</th>
          <th>Действие</th>
        </tr>
      </thead>
      <tbody>
        <% applicationList.forEach(function (r) { %>
          <tr>
            <td><%= r.id %></td>
            <td><%= r.user_name %> <span class="text-muted small">(<%= r.user_login %>)</span></td>
            <td><%= r.course_title %></td>
            <td><%= formatDateRu(r.start_date) %></td>
            <td><%= PAYMENT_METHOD[r.payment_method] %></td>
            <td><%= APPLICATION_STATUS[r.status] %></td>
            <td>
              <form method="post" action="/admin/applications/<%= r.id %>/status" class="d-flex gap-1 flex-wrap">
                <select name="status" class="form-select form-select-sm" style="width: auto;">
                  <% ['new','in_progress','completed'].forEach(function (s) { %>
                    <option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= APPLICATION_STATUS[s] %></option>
                  <% }); %>
                </select>
                <button type="submit" class="btn btn-sm btn-primary">Сохранить</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <a href="/admin" class="btn btn-link">Назад</a>
</main>
<%- include('../partials/footer') %>
