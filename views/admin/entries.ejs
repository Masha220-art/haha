<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container flex-grow-1">
  <h1 class="h4 mb-3">entries</h1>
  <div class="mb-3">
    <a class="btn btn-sm <%= !filter1 ? 'btn-dark' : 'btn-outline-secondary' %>" href="/admin/entries">all</a>
    <% ['pending','approved','rejected','cancelled'].forEach(function (s) { %>
      <a class="btn btn-sm <%= filter1 === s ? 'btn-primary' : 'btn-outline-secondary' %>" href="/admin/entries?status=<%= s %>"><%= s %></a>
    <% }); %>
  </div>
  <div class="table-responsive">
    <table class="table table-sm table-bordered align-middle">
      <thead>
        <tr><th>id</th><th>user</th><th>item</th><th>status</th><th>action</th></tr>
      </thead>
      <tbody>
        <% entryList.forEach(function (r) { %>
          <tr>
            <td><%= r.id %></td>
            <td><%= r.user_name %> <span class="text-muted small">(<%= r.user_email %>)</span></td>
            <td><%= r.item_title %></td>
            <td><%= r.status %></td>
            <td>
              <form method="post" action="/admin/entries/<%= r.id %>/status" class="d-flex gap-1 flex-wrap">
                <select name="status" class="form-select form-select-sm" style="width: auto;">
                  <% ['pending','approved','rejected','cancelled'].forEach(function (s) { %>
                    <option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= s %></option>
                  <% }); %>
                </select>
                <button type="submit" class="btn btn-sm btn-primary">ok</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <a href="/admin" class="btn btn-link">back</a>
</main>
<%- include('../partials/footer') %>
