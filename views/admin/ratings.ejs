<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container flex-grow-1">
  <h1 class="h4 mb-3">ratings</h1>
  <div class="mb-3">
    <a class="btn btn-sm <%= filter1 === 'pending' ? 'btn-warning' : 'btn-outline-secondary' %>" href="/admin/ratings?filter=pending">pending</a>
    <a class="btn btn-sm <%= filter1 === 'published' ? 'btn-success' : 'btn-outline-secondary' %>" href="/admin/ratings?filter=published">published</a>
    <a class="btn btn-sm <%= filter1 === 'rejected' ? 'btn-danger' : 'btn-outline-secondary' %>" href="/admin/ratings?filter=rejected">rejected</a>
    <a class="btn btn-sm <%= filter1 === 'all' ? 'btn-dark' : 'btn-outline-secondary' %>" href="/admin/ratings?filter=all">all</a>
  </div>
  <% if (!ratingList.length) { %>
    <p class="text-muted">empty.</p>
  <% } else { %>
    <% ratingList.forEach(function (r) { %>
      <div class="card mb-3">
        <div class="card-body">
          <p class="small text-muted mb-1">entry #<%= r.entry_ref %> · <%= r.item_title %> · <%= r.user_name %> (<%= r.user_email %>)</p>
          <p class="mb-1"><strong><%= r.rating %>/5</strong></p>
          <p><%= r.body %></p>
          <% if (r.moderation_status === 'pending') { %>
            <form method="post" action="/admin/ratings/<%= r.id %>/moderate" class="d-inline">
              <input type="hidden" name="action" value="publish">
              <button type="submit" class="btn btn-success btn-sm">pub</button>
            </form>
            <form method="post" action="/admin/ratings/<%= r.id %>/moderate" class="d-inline">
              <input type="hidden" name="action" value="reject">
              <button type="submit" class="btn btn-outline-danger btn-sm">rej</button>
            </form>
          <% } else { %>
            <span class="badge <%= r.moderation_status === 'published' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= r.moderation_status %></span>
          <% } %>
        </div>
      </div>
    <% }); %>
  <% } %>
  <a href="/admin" class="btn btn-link">back</a>
</main>
<%- include('../partials/footer') %>
