<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container flex-grow-1" style="max-width: 420px;">
  <h1 class="h4 mb-3">Регистрация</h1>
  <% if (err) { %><div class="alert alert-danger"><%= err %></div><% } %>
  <form method="post" action="/auth/register">
    <div class="mb-3">
      <label class="form-label" for="full_name">Имя</label>
      <input class="form-control" id="full_name" name="full_name" required value="<%= register1.full_name || '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label" for="email">Email</label>
      <input class="form-control" type="email" id="email" name="email" required value="<%= register1.email || '' %>">
    </div>
    <div class="mb-3">
      <label class="form-label" for="password">Пароль</label>
      <input class="form-control" type="password" id="password" name="password" required minlength="6">
    </div>
    <button type="submit" class="btn btn-primary w-100">Создать</button>
  </form>
  <p class="small text-muted mt-3"><a href="/auth/login">Вход</a></p>
</main>
<%- include('../partials/footer') %>
