<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="container flex-grow-1">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Мои записи</h1>
    <a class="btn btn-primary btn-sm" href="/entries/new">Новая</a>
  </div>
  <% if (!entryList.length) { %>
    <p class="text-muted">Пусто.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead><tr><th>id</th><th>item</th><th>status</th><th>rating</th><th></th></tr></thead>
        <tbody>
          <% entryList.forEach(function (r) { %>
            <tr>
              <td><%= r.id %></td>
              <td><%= r.item_title %></td>
              <td><span class="badge text-bg-secondary"><%= r.status %></span></td>
              <td class="small">
                <% if (r.rating_id) { %>
                  <% if (r.rating_mod === 'published') { %>ok<% } %>
                  <% if (r.rating_mod === 'pending') { %>mod<% } %>
                  <% if (r.rating_mod === 'rejected') { %>no<% } %>
                <% } else if (r.status === 'approved') { %>—<% } else { %>—<% } %>
              </td>
              <td><a class="btn btn-outline-secondary btn-sm" href="/entries/<%= r.id %>">open</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>
<%- include('../partials/footer') %>
